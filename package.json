{
  "name": "mis-inversiones",
  "productName": "Mis Inversiones",
  "version": "1.0.1",
  "description": "Administrador personal de inversiones basado en mi guía de inversión",
  "main": "main.js",
  "author": "Mis Inversiones",
  "license": "UNLICENSED",
  "private": true,
  "scripts": {
    "start": "electron .",
    "test": "node tests/calc.test.js",
    "dist": "electron-builder --win portable nsis --x64 --publish never",
    "prestart": "node scripts/prepare-mobile.js",
    "predist": "node scripts/prepare-mobile.js",
    "android:sync": "node scripts/prepare-mobile.js && cap sync android"
  },
  "devDependencies": {
    "@capacitor/cli": "^7.6.9",
    "electron": "^33.0.0",
    "electron-builder": "^25.1.8",
    "electron-updater": "^6.8.9",
    "esbuild": "^0.28.2"
  },
  "build": {
    "appId": "com.misinversiones.app",
    "productName": "Mis Inversiones",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "main.js",
      "preload.js",
      "src/**/*",
      "package.json"
    ],
    "win": {
      "icon": "build/icon.ico",
      "target": [
        "portable",
        "nsis"
      ]
    },
    "portable": {
      "artifactName": "Mis-Inversiones-portable.exe"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "artifactName": "Mis-Inversiones-instalador.exe",
      "createDesktopShortcut": true
    },
    "publish": [
      {
        "owner": "chillywilly33",
        "provider": "github",
        "repo": "Mi-portafolio",
        "releaseType": "release"
      }
    ]
  },
  "dependencies": {
    "@capacitor/android": "^7.6.9",
    "@capacitor/browser": "^7.0.5",
    "@capacitor/core": "^7.6.9"
  }
}
